# Production site URL (Crucial for SEO, canonical tags, sitemap.xml and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: Google Fonts Developer API Key (defaults to curated 24 fonts if empty)
GOOGLE_FONTS_API_KEY=

# Optional: Google Search Console meta verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional: Privacy-friendly analytics (plausible.io)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: Limit number of font pages initially submitted in sitemap.xml (default: 50)
SITEMAP_FONT_LIMIT=50

# Optional: Display ads toggle ("on" to enable ad slots)
NEXT_PUBLIC_ADS=

# Optional: Google AdSense Publisher ID for /ads.txt (e.g. pub-1234567890)
NEXT_PUBLIC_ADSENSE_CLIENT=

