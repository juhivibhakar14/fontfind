# Production site canonical URL (e.g. https://typematcher.com)
NEXT_PUBLIC_SITE_URL=

# Optional Google Fonts API Key to dynamically fetch extra font families (built-in list used if empty)
GOOGLE_FONTS_API_KEY=

# Optional Google Search Console meta verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional maximum number of font pages listed in sitemap.xml (defaults to 50 if empty)
SITEMAP_FONT_LIMIT=

# Optional domain name for cookieless Plausible analytics (e.g. yourdomain.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional display ads toggle (set to "on" to enable ad slots; empty keeps ads disabled)
NEXT_PUBLIC_ADS=

# Optional Google AdSense client ID for /ads.txt and ad integration (e.g. pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional public contact and support email address shown on Contact and Privacy pages
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional debug diagnostics toggle (set to "on" to display the in-browser debug panel)
NEXT_PUBLIC_DEBUG=
